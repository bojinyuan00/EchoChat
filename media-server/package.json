{
  "name": "@echochat/media-server",
  "version": "0.1.0",
  "private": true,
  "description": "EchoChat media-server: mediasoup SFU wrapped by Fastify, controlled by Go backend via internal REST",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/sensible": "6.0.4",
    "@fastify/websocket": "11.2.0",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "mediasoup": "3.19.0",
    "pino": "9.3.2",
    "pino-pretty": "11.2.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "tsx": "4.16.5",
    "typescript": "5.5.4",
    "vitest": "1.6.0"
  }
}
