# ============================================================
# EchoChat 本机 Demo 部署环境变量（默认值，即装即用）
# 用法：cp deploy/.env.local.example deploy/.env
# 说明：此模式下 coturn 不启动（需同一局域网 / 直连 IP 可达即可）
# ============================================================

DEPLOY_MODE=local

# ---- 中间件（与 docker-compose.dev.yml 默认值一致，通常无需修改）----
POSTGRES_DB=echochat
POSTGRES_USER=echochat
POSTGRES_PASSWORD=echochat_dev_2026

REDIS_PASSWORD=

MINIO_ROOT_USER=echochat
MINIO_ROOT_PASSWORD=echochat123456

# ---- Go backend ----
GO_SERVICE_PORT=8085
JWT_SECRET=echochat-dev-jwt-secret-2026-please-change-in-production

# ---- mediasoup ----
# announcedIp = 浏览器拿到的 ICE candidate 地址，跨设备建 WebRTC 必经此 IP。
# 本机 Demo 推荐留空：media-server 启动时自动探测当前活跃内网 IPv4（优先 192.168.x → 10.x → 172.16-31.x），
# 跳过 utun/vmnet/docker 等虚拟网卡，切换 Wi-Fi 后重启 media-server 即可，无需手改。
# 若手填，必须是本机当前 `ifconfig` 能看到的内网 IP；填错（旧 IP / 127.0.0.1）会导致跨设备永远黑屏。
MEDIA_INTERNAL_TOKEN=dev-internal-token-change-me
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40199

# ---- TURN 关闭 ----
TURN_ENABLED=false

# ============================================================
# 镜像源加速（可选，仅对 docker compose build 构建阶段生效）
# ------------------------------------------------------------
# 国内网络环境建议打开以下三项，构建可显著提速。海外/无墙环境留空即可。
# 注意：以下是 Linux 发行版镜像站（Debian/Alpine 官方镜像），不是 Docker Hub 加速。
# ============================================================
# APT_MIRROR=mirrors.aliyun.com      # media-server 容器的 Debian apt 源
# APK_MIRROR=mirrors.aliyun.com      # go-service 容器的 Alpine apk 源
# GO_BUILD_PROXY=https://goproxy.cn,direct   # 容器内 go mod download 代理
